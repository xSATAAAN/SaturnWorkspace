{
  "name": "saturn-workspace-policy-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "test:entitlement": "node scripts/check-entitlement-policy.mjs",
    "test:support": "node scripts/check-support-notifications.mjs",
    "test:invites": "node scripts/check-invites.mjs",
    "test:required": "npm run check && npm run test:entitlement && npm run test:support && npm run test:invites && node scripts/check-email-content.mjs && node scripts/check-admin-alerts.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply saturnws-policy --local",
    "migrate:remote": "wrangler d1 migrations apply saturnws-policy --remote"
  },
  "dependencies": {
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "esbuild": "^0.28.1",
    "miniflare": "^4.20260617.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.115.0"
  }
}
