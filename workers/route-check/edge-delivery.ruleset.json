{
  "schema": "saturnws.route-check.edge-delivery.v1",
  "contract": "../../contracts/desktop-control-plane.v1.json#route_check.delivery",
  "provider": "cloudflare",
  "scope": "zone",
  "phase": "http_config_settings",
  "ruleset_name": "Saturn Route Check API delivery",
  "rule": {
    "ref": "saturn_route_check_machine_api_no_bic",
    "description": "Do not apply browser-only integrity heuristics to Saturn capability-bound Route Check API calls",
    "expression": "(http.host in {\"route-check.saturnws.com\" \"v4.route-check.saturnws.com\" \"v6.route-check.saturnws.com\"} and starts_with(http.request.uri.path, \"/v1/\"))",
    "action": "set_config",
    "action_parameters": {
      "bic": false
    }
  },
  "rollback": "remove_only_the_rule_with_the_declared_ref"
}
