{
  "schema": "saturnws.desktop-control-plane.contract.v1",
  "contract_version": 1,
  "status": "canonical",
  "owners": {
    "producer": "SaturnWorkspace Web Auth and Policy Workers",
    "consumer": "SaturnWorkspace Desktop"
  },
  "product_invariants": {
    "account_connection_is_separate_from_entitlement": true,
    "linked_without_subscription_is_valid": true,
    "paid_access_requires_entitled_policy": true,
    "identity_owner_key": "firebase_uid",
    "policy_is_signed_and_fail_closed": true
  },
  "auth": {
    "connection_states": [
      "signed_out",
      "link_pending",
      "linked",
      "session_expired",
      "revoked",
      "offline",
      "error"
    ],
    "entitlement_states": [
      "unknown",
      "no_subscription",
      "active",
      "trial",
      "grace",
      "expired",
      "suspended",
      "lifetime"
    ],
    "entitled_states": [
      "active",
      "trial",
      "grace",
      "lifetime"
    ],
    "operations": {
      "device_start": {
        "method": "POST",
        "path": "/device/start",
        "request_required": [
          "hwid"
        ],
        "response": {
          "required": {
            "success": "boolean",
            "device_code": "non_empty_string",
            "user_code": "non_empty_string",
            "verification_url": "https_url",
            "expires_at": "iso_datetime",
            "expires_in": "positive_integer",
            "interval": "positive_integer"
          },
          "fixed": {
            "success": true
          }
        }
      },
      "device_complete": {
        "method": "POST",
        "path": "/device/complete",
        "request_required_any": [
          "device_code",
          "user_code"
        ],
        "request_required": [
          "id_token"
        ],
        "response": {
          "required": {
            "success": "boolean",
            "status": "non_empty_string",
            "connection_state": "string",
            "entitlement_state": "string",
            "entitlement": "object",
            "subscription": [
              "object",
              "null"
            ]
          },
          "fixed": {
            "success": true,
            "status": "authorized",
            "connection_state": "linked"
          },
          "enums": {
            "entitlement_state": "$auth.entitlement_states"
          }
        }
      },
      "device_poll_authorized": {
        "method": "POST",
        "path": "/device/poll",
        "request_required": [
          "device_code",
          "hwid"
        ],
        "response": {
          "required": {
            "success": "boolean",
            "status": "non_empty_string",
            "connection_state": "string",
            "entitlement_state": "string",
            "entitlement": "object",
            "subscription": [
              "object",
              "null"
            ],
            "session_token": "non_empty_string",
            "session_expires_at": "iso_datetime"
          },
          "fixed": {
            "success": true,
            "status": "authorized",
            "connection_state": "linked"
          },
          "enums": {
            "entitlement_state": "$auth.entitlement_states"
          }
        }
      },
      "session_verify": {
        "method": "POST",
        "path": "/session/verify",
        "request_required": [
          "session_token",
          "hwid"
        ],
        "response": {
          "required": {
            "success": "boolean",
            "connection_state": "string",
            "entitlement_state": "string",
            "entitlement": "object",
            "policy": "object",
            "session_expires_at": "iso_datetime"
          },
          "fixed": {
            "success": true,
            "connection_state": "linked"
          },
          "enums": {
            "entitlement_state": "$auth.entitlement_states"
          }
        }
      },
      "session_refresh": {
        "method": "POST",
        "path": "/session/refresh",
        "request_required": [
          "session_token",
          "hwid"
        ],
        "response": {
          "required": {
            "success": "boolean",
            "connection_state": "string",
            "session_token": "non_empty_string",
            "session_expires_at": "iso_datetime"
          },
          "fixed": {
            "success": true,
            "connection_state": "linked"
          }
        }
      },
      "error": {
        "response": {
          "required": {
            "success": "boolean",
            "error": "non_empty_string"
          },
          "fixed": {
            "success": false
          }
        }
      }
    },
    "compatibility": {
      "license": {
        "status": "deprecated_optional_alias",
        "canonical": "subscription"
      },
      "license_id": {
        "status": "deprecated_optional_alias",
        "canonical": "subscription_id"
      },
      "SATAN_environment_prefix": {
        "status": "legacy_local_compatibility",
        "canonical": "SATURNWS_environment_prefix"
      }
    }
  },
  "policy": {
    "decisions": [
      "allow",
      "deny_user",
      "subscription_required",
      "subscription_expired",
      "mandatory_update",
      "disabled_version",
      "global_kill_switch",
      "plan_feature_not_allowed",
      "policy_unavailable"
    ],
    "operations": {
      "check": {
        "method": "POST",
        "path": "/v1/policy/check",
        "authorization": "bearer_app_session",
        "response": {
          "required": {
            "success": "boolean",
            "decision": "string",
            "allow": "boolean",
            "reason": "non_empty_string",
            "message": "string",
            "plan": "string",
            "features": "object",
            "limits": "object",
            "blocked_actions": "array",
            "issued_at": "iso_datetime",
            "expires_at": "iso_datetime",
            "ttl_seconds": "positive_integer",
            "sticky": "boolean",
            "signature": "non_empty_string"
          },
          "fixed": {
            "success": true
          },
          "enums": {
            "decision": "$policy.decisions"
          },
          "relations": [
            {
              "kind": "equals",
              "left": "allow",
              "right_expression": "decision == 'allow'"
            }
          ]
        }
      }
    }
  },
  "route_check": {
    "origin": "https://route-check.saturnws.com",
    "owner": "SaturnWorkspace Web route-check Worker",
    "consumer": "SaturnWorkspace Desktop session lifecycle",
    "retention_seconds": {
      "default": 180,
      "minimum": 45,
      "maximum": 300
    },
    "privacy": {
      "attempt_identity": "random_ephemeral_token_only",
      "forbidden_request_data": [
        "saturn_account_identity",
        "email",
        "browser_profile_identity",
        "target_urls",
        "proxy_credentials",
        "browsing_content"
      ],
      "persistent_application_observability": false,
      "raw_network_result_deleted_on_finalize_or_expiry": true,
      "browser_secret_and_desktop_secret_are_distinct": true
    },
    "operations": {
      "initialize": {
        "method": "POST",
        "path": "/v1/attempts",
        "required": ["attempt_id", "browser_secret_hash", "desktop_secret_hash", "ttl_seconds"]
      },
      "observe": {
        "method": "POST",
        "path": "/v1/observe",
        "authorization": "browser_attempt_token",
        "required": ["ipv4_probe_attempted", "ipv6_probe_attempted", "browser_probe_completed", "webrtc_gathering_completed", "webrtc_public_candidate", "webrtc_public_candidates", "webrtc_private_candidate", "webrtc_relay_candidate"]
      },
      "result": {
        "method": "POST",
        "path": "/v1/result",
        "authorization": "desktop_attempt_token"
      },
      "decision": {
        "method": "POST",
        "path": "/v1/decision",
        "authorization": "desktop_attempt_token",
        "required": ["qualified", "code"]
      },
      "browser_result": {
        "method": "POST",
        "path": "/v1/browser-result",
        "authorization": "browser_attempt_token",
        "forbidden": ["raw_exit_ip", "network_observation"]
      },
      "browser_acknowledgement": {
        "method": "POST",
        "path": "/v1/browser-ack",
        "authorization": "browser_attempt_token",
        "effect": "confirm_visible_decision_rendered"
      },
      "finalize": {
        "method": "POST",
        "path": "/v1/finalize",
        "authorization": "desktop_attempt_token",
        "effect": "delete_attempt_state"
      }
    },
    "qualification": {
      "requires_https_exit_match": true,
      "requires_ipv4_and_ipv6_side_route_evidence": true,
      "requires_browser_probe": true,
      "requires_complete_webrtc_candidate_gathering": true,
      "requires_measurement_host_resolution": true,
      "proxy_dns_requires_authoritative_per_attempt_evidence": true,
      "current_proxy_dns_qualification_available": false,
      "webrtc_public_candidates_must_match_observed_exit": true,
      "webrtc_private_candidate_rejected": true,
      "requires_visible_browser_acknowledgement_before_targets": true,
      "unknown_or_conflicting_result_fails_closed": true,
      "does_not_claim_to_measure_dns_resolver_identity": true
    }
  },
  "qa_boundary": {
    "real_user_data": false,
    "production_credentials": false,
    "production_signing_keys": false,
    "deploy_or_release": false,
    "required_transport": "hermetic_loopback_or_in_process"
  }
}
